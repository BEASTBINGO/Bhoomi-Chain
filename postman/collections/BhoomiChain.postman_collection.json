  "item": [
    {
      "name": "1. Citizen Authentication",
      "item": [
        {
          "name": "Citizen Login (Auto-saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.token) {",
                  "    pm.collectionVariables.set('citizenToken', response.token);",
                  "    console.log('Saved citizenToken:', response.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bcid\": \"BCID-IND-2026-000001\",\n  \"mobile\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/citizens/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "citizens", "login"]
            }
          }
        },
        {
          "name": "Citizen Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{citizenToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/citizens/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "citizens", "profile"]
            }
          }
        }
      ]
