    {
      "name": "3. Document Upload & AI Analysis",
      "item": [
        {
          "name": "Upload Document (form-data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.document) {",
                  "    pm.collectionVariables.set('documentId', response.document._id);",
                  "    console.log('Saved documentId:', response.document._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{citizenToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "propertyId",
                  "value": "{{propertyId}}",
                  "type": "text"
                },
                {
                  "key": "documentType",
                  "value": "SALE_DEED",
                  "type": "text"
                },
                {
                  "key": "document",
                  "description": "Select real_property_document.pdf or suspicious_property_document.pdf",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "upload"]
            }
