                  "const response = pm.response.json();",
                  "if (response.success && response.transferRequest) {",
                  "    pm.collectionVariables.set('transferId', response.transferRequest._id);",
                  "    console.log('Saved transferId:', response.transferRequest._id);",
                  "}"
